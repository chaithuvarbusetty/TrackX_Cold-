# ==============================================================================
# TracX Cold Chain Platform Environment Configuration
# ==============================================================================

# Database Connection URL:
# 1. Default (SQLite WAL Mode):
# Leave DATABASE_URL empty or unset to use Frontend/data/coldchain.sqlite
DATABASE_URL=

# 2. Local Docker / TimescaleDB:
# DATABASE_URL=postgresql://coldchain:coldchain_secret@localhost:5432/coldchain_db

# 3. Cloud PostgreSQL (Neon / Supabase / AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-cool-cloud.us-east-2.aws.neon.tech/coldchain?sslmode=require

# Server Config:
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Permanent Static Domain for Firmware / Hardware (Optional: ngrok)
# Claim your 1 permanent free domain at https://dashboard.ngrok.com/cloud-edge/domains
# Flash your devices once with: https://YOUR-DOMAIN.ngrok-free.app/api/v1/telemetry
# ==============================================================================
# NGROK_AUTHTOKEN=your_ngrok_token_here
# NGROK_DOMAIN=your-static-name.ngrok-free.app

